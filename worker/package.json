{
  "name": "sparkdown-updater",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "esbuild src/index.ts --bundle --format=esm --outfile=dist/worker.js --platform=neutral --legal-comments=none",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "query": "node --experimental-strip-types query-counts.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.166.0"
  }
}
